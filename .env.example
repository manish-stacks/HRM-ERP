# Environment Configuration
NODE_ENV=development
PORT=5000

# Database (MySQL)
DATABASE_URL="mysql://hrm_user:hrm_password@localhost:3306/hrm_erp_db"

# JWT Authentication
JWT_SECRET="enterprise-hrm-jwt-super-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="enterprise-hrm-jwt-refresh-super-secret-key-at-least-32-chars-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & CORS
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN="localhost"
SECURE_COOKIES=false

# Face Recognition Attendance Settings
BIOMETRIC_SIMILARITY_THRESHOLD=0.60
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Redis / Background Worker (Optional)
REDIS_URL="redis://localhost:6379"

